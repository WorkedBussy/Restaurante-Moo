rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar para verificar si el usuario es administrador
    function esAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "administrador";
    }

    // Colección de Usuarios
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if esAdmin() || (request.auth != null && request.auth.uid == userId);
    }

    // Colección de Productos (Platos / Menú)
    match /productos/{productoId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Colección de Categorías
    match /categorias/{categoriaId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Colección de Pedidos
    match /pedidos/{pedidoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if esAdmin();
    }

    // Bitácora de movimientos de stock
    match /movimientos_stock/{movimientoId} {
      allow read: if esAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false; // Solo append, nunca borrar ni editar
    }
  }
}
